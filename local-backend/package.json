{
  "name": "aberturas-avenida-local-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Local Windows backend foundation for Aberturas Avenida",
  "type": "module",
  "engines": { "node": ">=22.14 <23" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/db.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "better-sqlite3": "12.2.0",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0"
  }
}
