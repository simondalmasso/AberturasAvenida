# Copy to .env locally. Never commit the real .env.
HOST=127.0.0.1
PORT=8788
DATA_DIR=./data
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_HEX_CHARS
# Generate with: node -e "const b=require('bcryptjs'); console.log(b.hashSync(process.env.TEMP_ADMIN_PASSWORD, 12))"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
NODE_ENV=production
